# Required
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token
ANTHROPIC_API_KEY=sk-ant-your-key
SESSION_PASSWORD=at-least-32-characters-secret-for-cookie-encryption

# Required for verified sign-in (existing Resend account + verified sender)
RESEND_API_KEY=re_your-key

AUTH_EMAIL_FROM=Fieldline <login@your-verified-domain.com>
